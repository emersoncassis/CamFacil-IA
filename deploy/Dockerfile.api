# CamFácil IA · API da nuvem (https://cfia.ysafe.com.br)
# Imagem final mínima: só o binário, sem shell.
FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY web ./web
COPY scripts ./scripts
# Script e QR do apoio, compartilhados com o site de documentação.
COPY site-docs/assets ./site-docs/assets
# Esquema da receita do modo estúdio (embutido pelo cf-core).
COPY docs/esquemas ./docs/esquemas
RUN cargo build --release --locked -p cfia-api

FROM gcr.io/distroless/cc-debian12:nonroot
LABEL org.opencontainers.image.source=https://github.com/emersoncassis/CamFacil-IA \
      org.opencontainers.image.description="Painel web do CamFácil IA (pareamento dos agentes)" \
      org.opencontainers.image.licenses=AGPL-3.0-only
COPY --from=build /src/target/release/cfia-api /usr/local/bin/cfia-api
ENV PORT=8080
EXPOSE 8080
USER nonroot
ENTRYPOINT ["/usr/local/bin/cfia-api"]
